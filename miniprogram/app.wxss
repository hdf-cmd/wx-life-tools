/* app.wxss */
/* 全局样式定义 */

/* ===== CSS 变量定义 ===== */
/* 设计语言 v2：借鉴 Vant/WeUI 生态主流小程序的视觉规范（柔和中性底、大圆角卡片、软阴影） */
page {
  /* 主色调 */
  --color-primary: #3E86E0;
  --color-primary-light: #66A3EC;
  --color-primary-dark: #2E6FC0;
  --gradient-primary: linear-gradient(135deg, #4A94E8 0%, #7BB8F5 100%);

  /* 辅助色 */
  --color-secondary: #FF9F43;
  --color-secondary-light: #FFB56B;
  --color-secondary-dark: #F08C2E;

  /* 功能色 */
  --color-success: #4CAF50;
  --color-success-light: #66BB6A;
  --color-danger: #FF5252;
  --color-danger-light: #FF6B6B;
  --color-warning: #FFC107;
  --color-info: #2196F3;

  /* 中性色 */
  --color-text-primary: #333333;
  --color-text-secondary: #666666;
  --color-text-placeholder: #999999;
  --color-text-disabled: #CCCCCC;

  /* 背景色 */
  --color-bg-page: #F4F6F9;
  --color-bg-card: #FFFFFF;
  --color-bg-hover: #F0F2F5;

  /* 边框色 */
  --color-border: #E8E8E8;
  --color-border-light: #F0F0F0;

  /* 间距 */
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;
  --spacing-xxl: 64rpx;

  /* 圆角 */
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 28rpx;
  --radius-xl: 36rpx;
  --radius-round: 999rpx;

  /* 阴影（软阴影，低对比度） */
  --shadow-sm: 0 4rpx 16rpx rgba(31, 45, 61, 0.05);
  --shadow-md: 0 8rpx 24rpx rgba(31, 45, 61, 0.08);
  --shadow-lg: 0 16rpx 40rpx rgba(31, 45, 61, 0.12);

  /* 字体大小 */
  --font-xs: 22rpx;
  --font-sm: 24rpx;
  --font-md: 28rpx;
  --font-lg: 32rpx;
  --font-xl: 36rpx;
  --font-xxl: 44rpx;

  /* 基础设置 */
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', 'Microsoft YaHei', sans-serif;
  font-size: var(--font-md);
  color: var(--color-text-primary);
  background-color: var(--color-bg-page);
  line-height: 1.6;
}

/* ===== 通用容器 ===== */
.container {
  padding: var(--spacing-lg);
  min-height: 100vh;
  box-sizing: border-box;
}

.container-sm {
  padding: var(--spacing-md);
}

/* ===== 卡片样式 ===== */
.card {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
  box-shadow: var(--shadow-sm);
}

.card-flat {
  background-color: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
}

/* ===== 页面头部规范（各列表页统一使用） ===== */
/* 用法：<view class="page-head"><view class="page-head-title">标题</view><view class="page-head-sub">副标题</view></view> */
.page-head {
  background: var(--gradient-primary);
  border-radius: var(--radius-xl);
  padding: 40rpx 36rpx;
  margin-bottom: var(--spacing-lg);
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
}

/* 装饰圆（可选，需在头部内放两个空 view） */
.page-head::before,
.page-head::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.page-head::before {
  width: 220rpx;
  height: 220rpx;
  right: -60rpx;
  top: -80rpx;
}

.page-head::after {
  width: 140rpx;
  height: 140rpx;
  right: 90rpx;
  bottom: -70rpx;
}

.page-head-title {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 1;
}

.page-head-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
  position: relative;
  z-index: 1;
}

/* ===== 按钮样式 ===== */
.btn-primary {
  background: var(--gradient-primary);
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-md);
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--font-md);
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
  box-shadow: 0 8rpx 20rpx rgba(62, 134, 224, 0.25);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background-color: var(--color-secondary);
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-md);
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--font-md);
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
}

.btn-secondary::after {
  border: none;
}

.btn-outline {
  background-color: transparent;
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-md);
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--font-md);
  text-align: center;
  line-height: 1.5;
}

.btn-outline::after {
  border: none;
}

/* 危险按钮 */
.btn-danger {
  background-color: var(--color-danger);
  color: #FFFFFF;
  border: none;
  border-radius: var(--radius-md);
  padding: var(--spacing-md) var(--spacing-xl);
  font-size: var(--font-md);
  font-weight: 500;
  text-align: center;
  line-height: 1.5;
}

.btn-danger::after {
  border: none;
}

.btn-block {
  display: block;
  width: 100%;
}

/* ===== 文字样式 ===== */
.text-primary {
  color: var(--color-primary);
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-success {
  color: var(--color-success);
}

.text-danger {
  color: var(--color-danger);
}

.text-hint,
.text-placeholder {
  color: var(--color-text-placeholder);
}

.text-center {
  text-align: center;
}

.text-bold {
  font-weight: 600;
}

/* ===== Flex 布局 ===== */
.flex,
.flex-row {
  display: flex;
  flex-direction: row;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
}

/* ===== 间距辅助类 ===== */
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mt-xl { margin-top: var(--spacing-xl); }

.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.mb-lg { margin-bottom: var(--spacing-lg); }
.mb-xl { margin-bottom: var(--spacing-xl); }

/* ===== 分割线 ===== */
.divider {
  height: 1rpx;
  background-color: var(--color-border);
  margin: var(--spacing-md) 0;
}

/* ===== 空状态 ===== */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xxl);
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: var(--spacing-lg);
}

.empty-text {
  font-size: var(--font-md);
  color: var(--color-text-placeholder);
}

/* ===== 深色模式适配 ===== */
@media (prefers-color-scheme: dark) {
  page {
    /* 中性色 - 深色模式 */
    --color-text-primary: #E5E5E5;
    --color-text-secondary: #AAAAAA;
    --color-text-placeholder: #777777;
    --color-text-disabled: #555555;

    /* 背景色 - 深色模式 */
    --color-bg-page: #111318;
    --color-bg-card: #1C1F26;
    --color-bg-hover: #262A33;

    /* 边框色 - 深色模式 */
    --color-border: #333333;
    --color-border-light: #2A2A2A;

    /* 阴影 - 深色模式 */
    --shadow-sm: 0 4rpx 16rpx rgba(0, 0, 0, 0.3);
    --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.4);
    --shadow-lg: 0 16rpx 40rpx rgba(0, 0, 0, 0.5);

    /* 主色渐变 - 深色模式降亮 */
    --gradient-primary: linear-gradient(135deg, #2E6FC0 0%, #4A94E8 100%);

    /* 基础设置 */
    color: var(--color-text-primary);
    background-color: var(--color-bg-page);
  }

  /* 卡片深色 */
  .card,
  .card-flat {
    background-color: var(--color-bg-card);
  }

  /* 主按钮保持主色，次按钮和轮廓按钮适配 */
  .btn-secondary {
    opacity: 0.9;
  }

  .btn-outline {
    color: var(--color-primary-light);
    border-color: var(--color-primary-light);
  }

  /* 操作菜单深色 */
  .action-sheet {
    background: #2A2A2A;
  }
}
