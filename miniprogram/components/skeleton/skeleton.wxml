<!--components/skeleton/skeleton.wxml-->
<!--骨架屏组件 - 加载状态占位-->

<view class="skeleton-container" wx:if="{{loading}}">
  <!-- 卡片占位 -->
  <view class="skeleton-card" wx:if="{{card}}" wx:for="{{[1,2,3]}}" wx:key="*this">
    <view class="skeleton-block skeleton-animate" style="height: 40rpx; width: 60%;"></view>
    <view class="skeleton-block skeleton-animate" style="height: 28rpx; width: 40%; margin-top: 16rpx;"></view>
  </view>

  <!-- 列表行占位 -->
  <view class="skeleton-list">
    <view class="skeleton-row" wx:for="{{rows}}" wx:key="*index">
      <!-- 头像占位 -->
      <view class="skeleton-avatar skeleton-animate" wx:if="{{avatar}}"></view>
      <!-- 文字占位 -->
      <view class="skeleton-content">
        <view class="skeleton-block skeleton-animate" style="height: 32rpx; width: 70%;"></view>
        <view class="skeleton-block skeleton-animate" style="height: 24rpx; width: 45%; margin-top: 16rpx;"></view>
      </view>
    </view>
  </view>
</view>
