/* pages/random/drink/index.wxss */
/* 喝什么 - 奶茶随机选择样式 */

.page-container {
  min-height: 100vh;
  padding: 40rpx 36rpx 60rpx;
  background: #FAFAFA;
  box-sizing: border-box;
}

/* ===== 品牌选择页 ===== */
.header {
  text-align: center;
  padding: 24rpx 0 32rpx;
}

.header-title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  color: #222;
  margin-bottom: 10rpx;
}

.header-sub {
  display: block;
  font-size: 24rpx;
  color: #AAA;
}

/* 附近品牌栏 */
.nearby-bar {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

/* 当前定位展示条 */
.location-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: -8rpx 0 20rpx;
  padding: 12rpx 24rpx;
  background: #F4F7FB;
  border-radius: 28rpx;
  font-size: 24rpx;
  color: #8A8A8A;
}

.location-icon {
  font-size: 26rpx;
}

.location-text {
  flex: 1;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.btn-nearby {
  width: 100%;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #3E86E0;
  background: #EBF3FF;
  border-radius: 40rpx;
  border: 2rpx solid #D0E2FF;
  padding: 0;
  margin: 0;
}

.btn-nearby::after {
  border: none;
}

.btn-nearby:active {
  opacity: 0.7;
  background: #DCE8FF;
}

.btn-nearby.loading {
  opacity: 0.6;
}

.btn-nearby-reset {
  font-size: 24rpx;
  color: #999;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  height: auto;
  line-height: 1.5;
}

.btn-nearby-reset::after {
  border: none;
}

/* 品牌卡片 - 有距离标记时 */
.brand-card.has-distance {
  border-color: #3E86E0;
  background: #F8FBFF;
}

.brand-distance {
  font-size: 20rpx;
  color: #3E86E0;
  margin-top: 4rpx;
  font-weight: 500;
}

.brand-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin-top: 16rpx;
}

.brand-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFF;
  border-radius: 24rpx;
  padding: 28rpx 16rpx 20rpx;
  border: 2rpx solid #F0F0F0;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
  transition: all 0.2s;
}

.brand-card:active {
  transform: scale(0.96);
  border-color: #FF6B6B;
  background: #FFF5F5;
}

.brand-logo {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  margin-bottom: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
}

.brand-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #222;
  margin-bottom: 4rpx;
}

.brand-count {
  font-size: 20rpx;
  color: #BBB;
}

/* ===== 饮品随机页 ===== */
.brand-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0 24rpx;
}

.brand-back {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
}

.back-arrow {
  font-size: 36rpx;
  color: #FF6B6B;
  font-weight: 300;
  margin-right: 4rpx;
}

.back-text {
  font-size: 24rpx;
  color: #FF6B6B;
}

.brand-header-name {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #222;
}

.header-logo {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.brand-header-count {
  font-size: 22rpx;
  color: #FF6B6B;
  background: #FFF0F0;
  border-radius: 14rpx;
  padding: 4rpx 14rpx;
}

/* 结果展示 */
.result-area {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx 0 32rpx;
  min-height: 200rpx;
}

.result-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-content.rolling {
  animation: rollShake 0.06s infinite;
}

@keyframes rollShake {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-2rpx); }
}

.result-content.pop {
  animation: popIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@keyframes popIn {
  0% { transform: scale(0.6); opacity: 0.4; }
  100% { transform: scale(1); opacity: 1; }
}

.result-name {
  font-size: 48rpx;
  font-weight: 700;
  color: #222;
  letter-spacing: 4rpx;
}

.result-price {
  font-size: 36rpx;
  font-weight: 600;
  color: #FF6B6B;
  margin-top: 12rpx;
}

.result-placeholder {
  font-size: 80rpx;
  color: #DDD;
  font-weight: 300;
}

/* 按钮 */
.actions {
  margin-top: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.btn-primary {
  width: 100%;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 600;
  color: #FFF;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E6B 100%);
  border-radius: 50rpx;
  border: none;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 107, 0.3);
  transition: opacity 0.15s ease;
  padding: 0;
  margin: 0;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
}

.btn-primary.disabled {
  opacity: 0.6;
}

.btn-row {
  display: flex;
  gap: 20rpx;
  width: 100%;
}

.btn-secondary {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #FF6B6B;
  background: #FFF;
  border: 2rpx solid #FFD8D8;
  border-radius: 44rpx;
  transition: opacity 0.15s ease;
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  opacity: 0.7;
  background: #FFF5F5;
}

/* 历史记录 */
.history {
  margin-top: 48rpx;
  padding: 0 0 20rpx;
}

.history-label {
  display: block;
  font-size: 26rpx;
  color: #BBB;
  margin-bottom: 16rpx;
}

.history-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.history-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  background: #FFF;
  border: 2rpx solid #F0F0F0;
  border-radius: 24rpx;
  padding: 10rpx 20rpx;
  font-size: 24rpx;
  color: #555;
}

.history-price {
  font-size: 20rpx;
  color: #FF6B6B;
  font-weight: 500;
}

/* ===== 管理面板 ===== */
.manage-panel {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease;
  margin-top: 32rpx;
}

.manage-panel.open {
  max-height: 1200rpx;
}

.panel-inner {
  background: #FFF;
  border-radius: 24rpx;
  padding: 24rpx;
  border: 2rpx solid #F0F0F0;
}

.add-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.add-input {
  flex: 1;
  height: 64rpx;
  background: #F7F7F7;
  border-radius: 14rpx;
  padding: 0 20rpx;
  font-size: 26rpx;
}

.btn-add {
  width: 110rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  color: #FFF;
  background: #FF6B6B;
  border-radius: 14rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.btn-add::after {
  border: none;
}

/* 标签分组 */
.tag-group {
  margin-bottom: 20rpx;
}

.tag-group-label {
  display: block;
  font-size: 24rpx;
  color: #888;
  margin-bottom: 12rpx;
}

.tag-scroll {
  max-height: 240rpx;
}

.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

/* 饮品标签 */
.drink-tag {
  display: inline-flex;
  align-items: center;
  gap: 4rpx;
  border-radius: 18rpx;
  padding: 6rpx 14rpx;
  font-size: 22rpx;
  transition: all 0.2s ease;
}

.drink-tag.custom {
  background: #FFF5ED;
  border: 2rpx solid #FFD8B8;
}

.drink-tag.preset {
  background: #FFF5F2;
  border: 2rpx solid #FFE0D6;
}

.drink-tag.excluded {
  background: #F5F5F5;
  border-color: #E8E8E8;
  opacity: 0.45;
}

.tag-text {
  color: #555;
}

.tag-price {
  font-size: 20rpx;
  color: #FF6B6B;
  font-weight: 500;
  margin-left: 2rpx;
}

.tag-close {
  font-size: 24rpx;
  color: #FF5252;
  font-weight: 300;
  margin-left: 4rpx;
  padding: 0 2rpx;
}

.tag-toggle {
  font-size: 24rpx;
  color: #BBB;
  margin-left: 4rpx;
  padding: 0 4rpx;
}

/* 恢复默认 */
.restore-row {
  text-align: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.btn-restore {
  display: inline-block;
  font-size: 24rpx;
  color: #999;
  background: transparent;
  border: 2rpx solid #E8E8E8;
  border-radius: 999rpx;
  padding: 10rpx 36rpx;
  line-height: 1.5;
}

.btn-restore::after {
  border: none;
}


/* ===== 深色模式适配 ===== */
@media (prefers-color-scheme: dark) {
  .page-container {
    background: #111111;
  }

  .header-title {
    color: #E5E5E5;
  }

  .header-sub {
    color: #777777;
  }

  .location-bar {
    background: #1E1E1E;
    color: #AAAAAA;
  }

  .btn-nearby {
    color: #66A3EC;
    background: #1A2A3F;
    border-color: #2A3A4F;
  }

  .btn-nearby:active {
    background: #253545;
  }

  .btn-nearby-reset {
    color: #777777;
  }

  .brand-card {
    background: #1E1E1E;
    border-color: #333333;
    box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.3);
  }

  .brand-card:active {
    border-color: #FF6B6B;
    background: #2A1A1A;
  }

  .brand-card.has-distance {
    border-color: #66A3EC;
    background: #1A2535;
  }

  .brand-name {
    color: #E5E5E5;
  }

  .brand-count {
    color: #777777;
  }

  .back-arrow,
  .back-text {
    color: #FF8080;
  }

  .brand-header-name {
    color: #E5E5E5;
  }

  .brand-header-count {
    color: #FF8080;
    background: #2A1A1A;
  }

  .result-name {
    color: #E5E5E5;
  }

  .result-placeholder {
    color: #555555;
  }

  .btn-secondary {
    color: #FF8080;
    background: #1E1E1E;
    border-color: #3A2020;
  }

  .btn-secondary:active {
    background: #2A1A1A;
  }

  .history-label {
    color: #777777;
  }

  .history-tag {
    background: #1E1E1E;
    border-color: #333333;
    color: #AAAAAA;
  }

  .manage-panel .panel-inner {
    background: #1E1E1E;
    border-color: #333333;
  }

  .add-input {
    background: #2A2A2A;
    color: #E5E5E5;
  }

  .tag-group-label {
    color: #777777;
  }

  .drink-tag.custom {
    background: #2A2010;
    border-color: #3A3020;
  }

  .drink-tag.preset {
    background: #2A1A15;
    border-color: #3A2520;
  }

  .drink-tag.excluded {
    background: #2A2A2A;
    border-color: #333333;
  }

  .tag-text {
    color: #AAAAAA;
  }

  .restore-row {
    border-top-color: #333333;
  }

  .btn-restore {
    color: #777777;
    border-color: #444444;
  }
}
