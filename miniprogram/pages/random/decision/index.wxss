/* pages/random/decision/index.wxss */
/* 随机决策器样式 */

/* ===== 页面容器 ===== */
.page-container {
  min-height: 100vh;
  padding: 32rpx 24rpx 60rpx;
  background: linear-gradient(180deg, #F0F4FF 0%, #F5F0FF 40%, var(--color-bg-page) 100%);
  box-sizing: border-box;
}

/* 结果展示区 */
.result-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.result-label {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 20rpx;
  letter-spacing: 4rpx;
}

.result-box {
  width: 500rpx;
  min-height: 140rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%);
  border-radius: var(--radius-xl);
  padding: 32rpx;
  box-shadow:
    0 16rpx 48rpx rgba(108, 92, 231, 0.25),
    0 6rpx 16rpx rgba(0, 0, 0, 0.08);
  animation: resultIn 0.4s ease;
}

@keyframes resultIn {
  0% { transform: scale(0.8); opacity: 0; }
  60% { transform: scale(1.08); }
  100% { transform: scale(1); opacity: 1; }
}

.result-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #FFFFFF;
  text-align: center;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.15);
  letter-spacing: 2rpx;
}

.result-emoji {
  font-size: 50rpx;
  margin-top: 16rpx;
  animation: sparkle 0.6s ease;
}

@keyframes sparkle {
  0%, 100% { transform: scale(1) rotate(0); }
  50% { transform: scale(1.2) rotate(10deg); }
}

/* 区块 */
.section {
  margin: 0 24rpx 24rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-left: 16rpx;
}

/* 选项输入框 */
.options-input {
  width: 100%;
  min-height: 200rpx;
  background: var(--color-bg-hover);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.8;
  box-sizing: border-box;
}

/* 操作按钮 */
.action-btns {
  padding: 24rpx 32rpx;
}

.action-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%);
  border-radius: 999rpx;
  border: none;
  box-shadow: 0 12rpx 36rpx rgba(108, 92, 231, 0.3);
  letter-spacing: 2rpx;
}

.action-btn::after {
  border: none;
}

.action-btn:active {
  transform: scale(0.96);
}

/* 滚动展示区 */
.rolling-area {
  margin: 0 24rpx 24rpx;
  padding: 24rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-sm);
}

.rolling-item {
  padding: 20rpx 32rpx;
  margin-bottom: 12rpx;
  border-radius: var(--radius-md);
  background: var(--color-bg-hover);
  font-size: 30rpx;
  color: var(--color-text-primary);
  transition: all 0.15s ease;
}

.rolling-item:last-child {
  margin-bottom: 0;
}

.rolling-item.active {
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%);
  color: #FFFFFF;
  transform: scale(1.04);
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.35);
}

/* 保存决策组 */
.save-row {
  display: flex;
  gap: 16rpx;
}

.save-input {
  flex: 1;
  height: 72rpx;
  background: var(--color-bg-hover);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 28rpx;
}

.btn-save {
  width: 140rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  padding: 0;
  background: var(--color-secondary);
  color: #FFFFFF;
  border-radius: var(--radius-md);
}

.btn-save::after {
  border: none;
}

/* 决策组列表 */
.group-list {
  margin-top: 16rpx;
}

.group-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--color-border-light);
}

.group-item:last-child {
  border-bottom: none;
}

.group-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.group-name {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 6rpx;
}

.group-options {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.group-delete {
  font-size: 26rpx;
  color: var(--color-danger);
  padding: 12rpx 20rpx;
}
