/* pages/random/group/index.wxss */
/* 抽签分组样式 */

/* 模式切换标签 */
.mode-tabs {
  display: flex;
  margin: 0 24rpx 24rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 8rpx;
  box-shadow: var(--shadow-sm);
}

.mode-tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 30rpx;
  color: var(--color-text-secondary);
  border-radius: var(--radius-md);
  transition: all 0.3s ease;
}

.mode-tab.active {
  background: linear-gradient(135deg, #FDCB6E 0%, #E17055 100%);
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(225, 112, 85, 0.3);
}

/* 区块 */
.section {
  margin: 0 24rpx 24rpx;
}

.section-header {
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-left: 16rpx;
}

/* 名字输入框 */
.names-input {
  width: 100%;
  min-height: 180rpx;
  background: var(--color-bg-hover);
  border-radius: var(--radius-md);
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.8;
  box-sizing: border-box;
}

.names-count {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  text-align: right;
}

/* 分组数量控制 */
.group-count-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.count-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg-hover);
  border-radius: 50%;
  font-size: 40rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  transition: all 0.2s ease;
}

.count-btn:active {
  background: var(--color-primary);
  color: #FFFFFF;
}

.count-display {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--color-primary);
  min-width: 80rpx;
  text-align: center;
}

/* 操作按钮 */
.action-btns {
  padding: 0 40rpx 24rpx;
}

.action-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: var(--radius-round);
}

/* 分组结果 */
.group-results {
  margin-top: 8rpx;
}

.group-result-item {
  margin-bottom: 24rpx;
  padding: 24rpx;
  background: var(--color-bg-hover);
  border-radius: var(--radius-md);
}

.group-result-item:last-child {
  margin-bottom: 0;
}

.group-header {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-primary);
  margin-bottom: 16rpx;
  padding-bottom: 12rpx;
  border-bottom: 1rpx solid var(--color-border-light);
}

.group-members {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.member-tag {
  background: linear-gradient(135deg, #FDCB6E 0%, #E17055 100%);
  color: #FFFFFF;
  padding: 10rpx 24rpx;
  border-radius: var(--radius-round);
  font-size: 26rpx;
  font-weight: 500;
}

/* 抽签设置 */
.draw-settings {
  display: flex;
  gap: 32rpx;
}

.draw-item {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.draw-label {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-bottom: 12rpx;
}

.draw-input {
  height: 80rpx;
  background: var(--color-bg-hover);
  border-radius: var(--radius-md);
  padding: 0 24rpx;
  font-size: 36rpx;
  font-weight: 600;
  text-align: center;
}

/* 抽签结果 */
.draw-results {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  justify-content: center;
}

.draw-result-item {
  background: linear-gradient(135deg, #FDCB6E 0%, #E17055 100%);
  padding: 24rpx 40rpx;
  border-radius: var(--radius-lg);
  box-shadow: 0 4rpx 16rpx rgba(225, 112, 85, 0.3);
  animation: popIn 0.3s ease;
}

@keyframes popIn {
  0% { transform: scale(0.8); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.draw-number {
  font-size: 36rpx;
  font-weight: 700;
  color: #FFFFFF;
}

/* 抽签动画 */
.draw-animation {
  display: flex;
  justify-content: center;
  padding: 60rpx 0;
}

.draw-anim-text {
  font-size: 40rpx;
  animation: pulse 0.8s infinite;
}

@keyframes pulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.6; transform: scale(0.95); }
}
