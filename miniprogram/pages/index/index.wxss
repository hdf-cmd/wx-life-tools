/* pages/index/index.wxss */
/* 首页样式（设计语言 v2） */

.index-page {
  padding-bottom: 60rpx;
}

/* ===== Hero 问候区 ===== */
.hero {
  background: var(--gradient-primary);
  border-radius: var(--radius-xl);
  padding: 44rpx 36rpx 40rpx;
  color: #FFFFFF;
  position: relative;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(62, 134, 224, 0.28);
}

/* 装饰圆 */
.hero::before,
.hero::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.hero::before {
  width: 260rpx;
  height: 260rpx;
  right: -70rpx;
  top: -100rpx;
}

.hero::after {
  width: 150rpx;
  height: 150rpx;
  left: -50rpx;
  bottom: -60rpx;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.hero-text {
  font-size: 42rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.hero-date {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 12rpx;
}

.hero-emoji {
  font-size: 72rpx;
  flex-shrink: 0;
}

.hero-weather {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.hero-weather-icon {
  font-size: 60rpx;
  margin-right: 14rpx;
}

.hero-weather-info {
  text-align: right;
}

.hero-weather-temp {
  font-size: 34rpx;
  font-weight: 700;
  color: #FFFFFF;
  line-height: 1.2;
}

.hero-weather-city {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
  margin-top: 6rpx;
  max-width: 240rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.hero-slogan {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 28rpx;
  position: relative;
  z-index: 1;
}

/* ===== 区域标题 ===== */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 36rpx 4rpx 20rpx;
}

/* ===== 实时统计 ===== */
.stats-row {
  display: flex;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 28rpx 12rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: var(--shadow-sm);
  position: relative;
  overflow: hidden;
}

.stat-card:active {
  transform: scale(0.97);
}


.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: var(--color-primary);
  line-height: 1.2;
}

.stat-unit {
  font-size: 20rpx;
  color: var(--color-text-placeholder);
  margin-top: 2rpx;
}

.stat-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

/* ===== 功能快捷入口 ===== */
.quick-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.quick-card {
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx 28rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s ease;
}

.quick-hover {
  transform: scale(0.97);
  opacity: 0.92;
}

.quick-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: var(--radius-md);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

/* 四张快捷卡的图标底板配色（与 ICON-DESIGN.md 的卡片主色一一对应） */
.quick-icon--bookkeeping { background: linear-gradient(135deg, #E3F0FF 0%, #CFE4FF 100%); }
.quick-icon--habit { background: linear-gradient(135deg, #E4F7E6 0%, #CFF0D3 100%); }
.quick-icon--random { background: linear-gradient(135deg, #FFEBE8 0%, #FFD9D3 100%); }
.quick-icon--toolbox { background: linear-gradient(135deg, #F1EAFE 0%, #E4D8FB 100%); }

/* 深色下不用浅色渐变（贴在深色卡上像块白斑），改为同色相半透明，与图标 active 态同一套语言 */
@media (prefers-color-scheme: dark) {
  .quick-icon--bookkeeping { background: rgba(62, 134, 224, 0.20); }
  .quick-icon--habit { background: rgba(60, 177, 98, 0.20); }
  .quick-icon--random { background: rgba(232, 93, 117, 0.20); }
  .quick-icon--toolbox { background: rgba(138, 99, 232, 0.20); }
}

.quick-icon-img {
  width: 52rpx;
  height: 52rpx;
}

.quick-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.quick-desc {
  font-size: 22rpx;
  color: var(--color-text-placeholder);
  margin-top: 8rpx;
  line-height: 1.4;
}

/* ===== 底部提示 ===== */
.footer-tip {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-placeholder);
  margin-top: 48rpx;
}
