/* pages/habit/habit.wxss */
/* 习惯打卡 - 列表页样式 */

.habit-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  background: var(--color-bg-page);
}

/* ===== 顶部日期区域（统一 page-head 卡片规范） ===== */
.date-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 36rpx;
  background: var(--gradient-primary);
  color: #fff;
  border-radius: var(--radius-xl);
  margin: 24rpx;
  position: relative;
  overflow: hidden;
}

.date-header::before,
.date-header::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.date-header::before {
  width: 200rpx;
  height: 200rpx;
  right: -50rpx;
  top: -80rpx;
}

.date-header::after {
  width: 120rpx;
  height: 120rpx;
  left: -40rpx;
  bottom: -60rpx;
}

.date-left {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  position: relative;
  z-index: 1;
}

.date-text {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.weekday-text {
  font-size: 28rpx;
  opacity: 0.85;
}

.date-subtitle {
  font-size: 26rpx;
  opacity: 0.9;
  background: rgba(255,255,255,0.2);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  position: relative;
  z-index: 1;
}

/* ===== 鼓励提示条 ===== */
.encourage-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 20rpx;
  background: #E8F5E9;
  transform: translateY(-100%);
  opacity: 0;
  transition: all 0.4s ease;
}

.encourage-bar.show {
  transform: translateY(0);
  opacity: 1;
}

.encourage-icon {
  font-size: 32rpx;
}

.encourage-text {
  font-size: 28rpx;
  color: #2E7D32;
  font-weight: 500;
}

/* ===== 加载状态 ===== */
.loading-wrap {
  display: flex;
  justify-content: center;
  padding: 100rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: var(--color-text-placeholder);
}

/* ===== 习惯卡片列表 ===== */
.habit-list {
  padding: 0 24rpx;
}

.habit-card {
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  transition: all 0.2s ease;
  position: relative;
  overflow: hidden;
}

.habit-card.checked {
  background: #F1F8E9;
  border-left: 6rpx solid var(--color-success);
}

.card-hover {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 左侧图标 */
.card-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #F5F5F5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.habit-card.checked .card-icon {
  background: #E8F5E9;
}

.icon-emoji {
  font-size: 44rpx;
}

/* 中间信息 */
.card-info {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.habit-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.card-meta {
  display: flex;
  align-items: center;
}

.streak-text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.habit-card.checked .streak-text {
  color: #E65100;
}

/* 右侧打卡状态 */
.card-status {
  flex-shrink: 0;
  margin-left: 16rpx;
}

.status-checked {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.status-checked .status-icon {
  font-size: 40rpx;
}

.status-checked .status-text {
  font-size: 22rpx;
  color: var(--color-success);
  font-weight: 500;
}

.status-unchecked {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.status-unchecked .status-icon {
  font-size: 40rpx;
  color: var(--color-primary);
}

.status-unchecked .status-text {
  font-size: 22rpx;
  color: var(--color-primary);
  font-weight: 500;
}

/* ===== 空状态 ===== */
.empty-wrap {
  padding: 80rpx 40rpx;
}

/* ===== 底部浮动按钮 ===== */
.fab-btn {
  position: fixed;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: #fff;
  padding: 24rpx 56rpx;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(74,144,217,0.4);
  z-index: 100;
}

.fab-hover {
  transform: translateX(-50%) scale(0.95);
  opacity: 0.9;
}

.fab-text {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ===== 长按操作菜单 ===== */
.action-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}

.action-sheet {
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
}

.action-title {
  text-align: center;
  padding: 32rpx;
  font-size: 28rpx;
  color: var(--color-text-placeholder);
  border-bottom: 1rpx solid var(--color-border-light);
}

.action-item {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 32rpx;
  font-size: 32rpx;
  color: var(--color-text-primary);
  border-bottom: 1rpx solid var(--color-border-light);
}

.action-item:active {
  background: var(--color-bg-hover);
}

.action-danger {
  color: var(--color-danger);
}

.action-cancel {
  margin-top: 16rpx;
  color: var(--color-text-secondary);
  border-bottom: none;
  padding-bottom: 40rpx;
}

.action-icon {
  font-size: 32rpx;
}
