/* pages/habit/add.wxss */
/* 习惯打卡 - 添加/编辑页样式 */

.add-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 120rpx;
  background: var(--color-bg-page);
}

/* ===== 表单区块 ===== */
.form-section {
  background: var(--color-bg-card);
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
}

.form-input {
  width: 100%;
  height: 80rpx;
  background: #F8F8F8;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: var(--color-text-primary);
  box-sizing: border-box;
}

/* ===== 图标选择 ===== */
.icon-preview {
  display: flex;
  justify-content: center;
  margin-bottom: 24rpx;
}

.preview-emoji {
  font-size: 80rpx;
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F5F5F5;
  border-radius: 24rpx;
}

.icon-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.icon-item {
  width: calc(20% - 14rpx);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: #F8F8F8;
  transition: all 0.2s;
}

.icon-item.selected {
  background: #E3F2FD;
  box-shadow: 0 0 0 3rpx var(--color-primary);
}

.item-emoji {
  font-size: 36rpx;
}

.item-label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.icon-item.selected .item-label {
  color: var(--color-primary);
  font-weight: 500;
}

/* ===== 频率选择 ===== */
.freq-options {
  display: flex;
  gap: 20rpx;
}

.freq-btn {
  flex: 1;
  height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #F5F5F5;
  font-size: 30rpx;
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.freq-btn.active {
  background: var(--color-primary);
  color: #fff;
  font-weight: 500;
}

/* 每周 - 周几选择 */
.week-picker {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.week-item {
  width: calc(25% - 12rpx);
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: #F5F5F5;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  transition: all 0.2s;
}

.week-item.selected {
  background: #E3F2FD;
  color: var(--color-primary);
  font-weight: 600;
  box-shadow: 0 0 0 2rpx var(--color-primary);
}

/* ===== 保存按钮 ===== */
.save-section {
  margin-top: 40rpx;
  padding: 0 16rpx;
}

.save-btn {
  width: 100%;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-dark) 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 48rpx;
  border: none;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 24rpx rgba(74,144,217,0.3);
  padding: 0;
  margin: 0;
  box-sizing: border-box;
}

.save-btn.disabled {
  opacity: 0.6;
}

.save-btn::after {
  border: none;
}
