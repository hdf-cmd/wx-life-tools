/* pages/bookkeeping/stats.wxss */
/* 统计页面样式 */

.stats-page {
  padding-bottom: var(--spacing-xl);
}

/* ===== 月份切换器 ===== */
.month-switcher {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-md) 0;
}

.arrow-btn {
  padding: var(--spacing-sm) var(--spacing-md);
}

.arrow {
  font-size: var(--font-sm);
  color: var(--color-primary);
}

.month-text {
  font-size: var(--font-xl);
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 0 var(--spacing-md);
}

/* ===== 汇总卡片 ===== */
.summary-card {
  background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  color: #fff;
}

.summary-row {
  display: flex;
  justify-content: space-around;
  align-items: center;
}

.summary-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.summary-divider {
  width: 2rpx;
  height: 60rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

.summary-label {
  font-size: var(--font-sm);
  opacity: 0.85;
  margin-bottom: var(--spacing-xs);
}

.summary-value {
  font-size: var(--font-lg);
  font-weight: 700;
}

.summary-value.income {
  color: #B8F5B0;
}

.summary-value.expense {
  color: #FFD6D6;
}

.summary-value.balance {
  color: #fff;
}

/* ===== 分类统计 ===== */
.category-stats {
  margin-top: var(--spacing-lg);
}

.section-title {
  font-size: var(--font-lg);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-lg);
  display: block;
}

.category-item {
  margin-bottom: var(--spacing-lg);
}

.category-item:last-child {
  margin-bottom: 0;
}

.category-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: var(--spacing-sm);
}

.category-left {
  display: flex;
  align-items: center;
}

.category-icon {
  font-size: 40rpx;
  margin-right: var(--spacing-sm);
}

.category-name {
  font-size: var(--font-md);
  color: var(--color-text-primary);
  font-weight: 500;
}

.category-right {
  display: flex;
  align-items: center;
}

.category-amount {
  font-size: var(--font-md);
  color: var(--color-text-primary);
  font-weight: 600;
  margin-right: var(--spacing-md);
}

.category-percent {
  font-size: var(--font-sm);
  color: var(--color-text-secondary);
  min-width: 80rpx;
  text-align: right;
}

/* ===== 进度条 ===== */
.progress-bar {
  height: 12rpx;
  background-color: var(--color-border-light);
  border-radius: var(--radius-round);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--color-primary) 0%, var(--color-primary-light) 100%);
  border-radius: var(--radius-round);
  transition: width 0.3s ease;
}

/* ===== 近 6 个月趋势 ===== */
.trend-card {
  margin-bottom: var(--spacing-md);
}

.trend-chart {
  display: flex;
  align-items: stretch;
  justify-content: space-around;
  margin-top: var(--spacing-md);
}

.trend-col {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.trend-bars {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  gap: 10rpx;
  height: 200rpx;
  width: 100%;
}

.trend-bar {
  width: 20rpx;
  border-radius: 6rpx 6rpx 0 0;
  min-height: 6rpx;
}

.trend-bar.income {
  background: var(--color-success-light);
}

.trend-bar.expense {
  background: var(--color-primary-light);
}

.trend-bar.expense.current {
  background: var(--color-primary);
}

.trend-label {
  margin-top: var(--spacing-xs);
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}

.trend-label.current {
  color: var(--color-primary);
  font-weight: 600;
}

.trend-legend {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-top: var(--spacing-md);
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-text-secondary);
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.legend-dot.income { background: var(--color-success-light); }
.legend-dot.expense { background: var(--color-primary-light); }

.legend-hint {
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}

/* ===== 导出按钮 ===== */
.export-btn {
  margin: var(--spacing-md) 0 var(--spacing-xl);
  background: var(--color-bg-card);
  color: var(--color-text-secondary);
  border-radius: var(--radius-lg);
  font-size: var(--font-sm);
  box-shadow: var(--shadow-sm);
  line-height: 2.6;
}

.export-btn::after {
  border: none;
}

.export-hover {
  opacity: 0.85;
}
