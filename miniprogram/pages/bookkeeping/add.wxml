<!--pages/bookkeeping/add.wxml-->
<!--记一笔页面-->

<view class="container add-page">
  <!-- 顶部类型切换 -->
  <view class="type-switcher">
    <view
      class="type-tab {{type === 'expense' ? 'active' : ''}}"
      bindtap="switchType"
      data-type="expense"
    >
      <text>支出</text>
    </view>
    <view
      class="type-tab {{type === 'income' ? 'active' : ''}}"
      bindtap="switchType"
      data-type="income"
    >
      <text>收入</text>
    </view>
  </view>

  <!-- 金额输入区域 -->
  <view class="amount-section">
    <text class="currency-sign">¥</text>
    <input
      class="amount-input"
      type="digit"
      placeholder="0.00"
      value="{{amount}}"
      bindinput="onAmountInput"
      focus="{{true}}"
    />
  </view>

  <!-- 分类选择 -->
  <view class="category-section">
    <text class="section-title">选择分类</text>
    <view class="category-grid">
      <view
        class="category-item {{selectedCategory.name === item.name ? 'selected' : ''}}"
        wx:for="{{categories}}"
        wx:key="name"
        bindtap="selectCategory"
        data-category="{{item.name}}"
      >
        <text class="category-icon">{{item.icon}}</text>
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>
  </view>

  <!-- 备注输入 -->
  <view class="note-section">
    <text class="section-title">备注</text>
    <input
      class="note-input"
      placeholder="添加备注（可选）"
      value="{{note}}"
      bindinput="onNoteInput"
      maxlength="50"
    />
  </view>

  <!-- 日期选择 -->
  <view class="date-section">
    <text class="section-title">日期</text>
    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="date-picker">
        <text class="date-text">{{date}}</text>
        <text class="date-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 保存按钮，saving 时禁用防止重复提交 -->
  <button class="btn-primary btn-block save-btn" bindtap="saveBill" disabled="{{saving}}">
    {{saving ? '保存中...' : '保存'}}
  </button>
</view>
