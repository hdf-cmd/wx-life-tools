/* pages/toolbox/index.wxss */
/* 工具箱主页 */

.page-container {
  min-height: 100vh;
  padding: 24rpx 24rpx 60rpx;
  background: var(--color-bg-page);
  box-sizing: border-box;
}

/* 页面头部：统一 page-head 卡片规范 */
.header {
  position: relative;
  overflow: hidden;
  background: var(--gradient-primary);
  border-radius: var(--radius-xl);
  padding: 44rpx 36rpx;
  margin-bottom: 32rpx;
  text-align: left;
}

.header::before,
.header::after {
  content: '';
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.header::before {
  width: 220rpx;
  height: 220rpx;
  right: -60rpx;
  top: -80rpx;
}

.header::after {
  width: 140rpx;
  height: 140rpx;
  right: 90rpx;
  bottom: -70rpx;
}

.header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #FFFFFF;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.header-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.85);
  position: relative;
  z-index: 1;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-secondary);
  margin: 40rpx 0 20rpx;
}

.entry-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.entry-card {
  display: flex;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: var(--radius-lg);
  padding: 30rpx 28rpx;
  border: 2rpx solid var(--color-border-light);
  box-shadow: var(--shadow-sm);
  transition: all 0.2s;
}

.entry-card:active {
  transform: scale(0.98);
  border-color: var(--color-primary);
  background: #F0F7FF;
}

.entry-icon {
  font-size: 60rpx;
  margin-right: 24rpx;
}

.entry-icon-img {
  width: 64rpx;
  height: 64rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.entry-text {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.entry-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  margin-bottom: 4rpx;
}

.entry-desc {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

.entry-arrow {
  font-size: 48rpx;
  color: var(--color-primary);
  font-weight: 300;
}

.contact-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(135deg, #E8F2FC 0%, #F0F7FF 100%);
  border: 2rpx solid #C9DFF5;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.contact-info {
  display: flex;
  align-items: center;
  flex: 1;
}

.contact-icon {
  font-size: 56rpx;
  margin-right: 20rpx;
}

.contact-text {
  display: flex;
  flex-direction: column;
}

.contact-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2C5F94;
  margin-bottom: 6rpx;
}

.contact-desc {
  font-size: 22rpx;
  color: #6B8DB5;
}

.contact-btn {
  background: var(--gradient-primary);
  color: #FFF;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 40rpx;
  padding: 0 32rpx;
  line-height: 64rpx;
  margin: 0;
}

.contact-btn::after {
  border: none;
}

.online-tip {
  font-size: 22rpx;
  color: #AAA;
  margin-bottom: 16rpx;
}

.online-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.online-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: var(--color-bg-card);
  border-radius: var(--radius-md);
  padding: 24rpx 8rpx;
  border: 2rpx solid var(--color-border-light);
  transition: all 0.2s;
}

.online-item:active {
  transform: scale(0.96);
  border-color: var(--color-primary);
  background: #F0F7FF;
}

.online-icon {
  font-size: 48rpx;
  margin-bottom: 10rpx;
}

.online-title {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* ===== 深色模式 ===== */
@media (prefers-color-scheme: dark) {
  .page-container { background: var(--color-bg-page); }
  .header-title { color: #FFF; }
  .header-sub { color: rgba(255, 255, 255, 0.85); }
  .section-title { color: #BBB; }
  .entry-card, .online-item {
    background: var(--color-bg-card);
    border-color: #2A2A2A;
  }
  .entry-card:active, .online-item:active {
    border-color: var(--color-primary);
    background: #1A2836;
  }
  .entry-title { color: #EEE; }
  .entry-desc, .online-tip { color: #777; }
  .online-title { color: #BBB; }
  .contact-card {
    background: linear-gradient(135deg, #1A2836 0%, #16202B 100%);
    border-color: #2A4258;
  }
  .contact-title { color: #8FC1F2; }
  .contact-desc { color: #5F7E9E; }
}

/* ===== 意见反馈 ===== */
.feedback-wrap {
  margin-top: var(--spacing-lg);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.feedback-btn {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: var(--color-bg-card);
  border-radius: var(--radius-round);
  padding: 18rpx 44rpx;
  box-shadow: var(--shadow-sm);
  font-size: var(--font-md);
  color: var(--color-text-secondary);
  line-height: 1.4;
}

.feedback-btn::after {
  border: none;
}

.feedback-hover {
  opacity: 0.85;
  transform: scale(0.97);
}

.feedback-icon {
  font-size: 30rpx;
}

.feedback-tip {
  margin-top: var(--spacing-sm);
  font-size: var(--font-xs);
  color: var(--color-text-placeholder);
}
