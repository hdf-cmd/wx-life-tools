/* pages/toolbox/common.wxss */
/* 工具箱子页面公共样式 */

.tool-page {
  min-height: 100vh;
  padding: 40rpx 36rpx 80rpx;
  background: #FAFAFA;
  box-sizing: border-box;
}

.tool-header {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.tool-header-icon {
  font-size: 80rpx;
}

.tool-header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #222;
  margin-top: 12rpx;
}

.tool-header-sub {
  display: block;
  font-size: 24rpx;
  color: #AAA;
  margin-top: 8rpx;
}

.tool-card {
  background: #FFF;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  border: 2rpx solid #F0F0F0;
}

.tool-card-title {
  font-size: 26rpx;
  color: #888;
  margin-bottom: 20rpx;
  font-weight: 600;
}

.choose-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
  border: 2rpx dashed #CCC;
  border-radius: 20rpx;
}

.choose-area-icon {
  font-size: 64rpx;
  margin-bottom: 12rpx;
}

.choose-area-text {
  font-size: 26rpx;
  color: #999;
}

.option-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
}

.option-label {
  font-size: 28rpx;
  color: #555;
}

.option-value {
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
}

.picker-box {
  background: #F5F5F5;
  border-radius: 12rpx;
  padding: 10rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 2rpx solid #F5F5F5;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  color: #888;
  font-size: 28rpx;
}

.info-value {
  color: #333;
  font-size: 28rpx;
  font-weight: 600;
  max-width: 60%;
  text-align: right;
}

.primary-btn {
  background: #3E86E0;
  color: #FFF;
  border-radius: 44rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.primary-btn:active {
  opacity: 0.85;
}

.primary-btn.disabled {
  background: #CCC;
}

.secondary-btn {
  background: #FFF;
  color: #3E86E0;
  border: 2rpx solid #3E86E0;
  border-radius: 44rpx;
  padding: 22rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 16rpx;
}

.result-highlight {
  color: #3E86E0;
  font-weight: 700;
}

.empty-tip {
  text-align: center;
  color: #BBB;
  font-size: 26rpx;
  padding: 40rpx 0;
}

/* ===== 深色模式 ===== */
@media (prefers-color-scheme: dark) {
  .tool-page { background: #111; }
  .tool-header-title { color: #EEE; }
  .tool-header-sub { color: #777; }
  .tool-card {
    background: #1E1E1E;
    border-color: #2A2A2A;
  }
  .tool-card-title { color: #888; }
  .choose-area { border-color: #3A3A3A; }
  .choose-area-text { color: #777; }
  .option-label { color: #AAA; }
  .option-value, .picker-box { color: #EEE; }
  .picker-box { background: #2A2A2A; }
  .info-label { color: #888; }
  .info-value { color: #EEE; }
  .info-row { border-bottom-color: #2A2A2A; }
  .secondary-btn {
    background: #1E1E1E;
  }
  .empty-tip { color: #666; }
}
