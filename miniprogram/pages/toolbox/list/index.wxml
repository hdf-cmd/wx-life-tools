<!--pages/toolbox/list/index.wxml-->
<!--工具箱二级页面 - 按分类展示具体工具-->

<view class="page-container">
  <!-- 本地工具列表 -->
  <view class="entry-list" wx:if="{{tools.length}}">
    <view
      class="entry-card"
      wx:for="{{tools}}"
      wx:key="title"
      data-page="{{item.page}}"
      bindtap="goToPage"
    >
      <text class="entry-icon">{{item.icon}}</text>
      <view class="entry-text">
        <text class="entry-title">{{item.title}}</text>
        <text class="entry-desc">{{item.desc}}</text>
      </view>
      <text class="entry-arrow">›</text>
    </view>
  </view>

  <!-- 在线编辑工具 -->
  <block wx:if="{{online.length}}">
    <!-- 第三方声明：客服入口和复制链接两条路径都给同一个外部站，所以放在整块最前面盖住两者 -->
    <view class="online-notice">
      <text class="online-notice-strong">以下在线工具由第三方网站提供，非本项目运营。</text>
      <text class="online-notice-text">页面内容、可用性与隐私政策均由对方负责；本项目不存储、也不处理你的文件。请勿在其中填写个人信息或上传敏感资料。</text>
    </view>

    <!-- 客服入口：点击后在客服会话中获取链接，点开即用 -->
    <view class="contact-card">
      <view class="contact-info">
        <text class="contact-icon">💬</text>
        <view class="contact-text">
          <text class="contact-title">一键打开在线工具</text>
          <text class="contact-desc">点击联系客服，回复“工具”获取链接，点开即用</text>
        </view>
      </view>
      <button class="contact-btn" open-type="contact" session-from="tools">获取链接</button>
    </view>

    <view class="online-tip">或点击工具复制链接，到浏览器打开（第三方站点）</view>
    <view class="online-grid">
      <view
        class="online-item"
        wx:for="{{online}}"
        wx:key="title"
        data-path="{{item.path}}"
        bindtap="openOnline"
      >
        <text class="online-icon">{{item.icon}}</text>
        <text class="online-title">{{item.title}}</text>
      </view>
    </view>
  </block>
</view>
